/* Rule 1: Parser accuracy 100% */
/* Tests P1-P5: Operator precedence, ternary, function calls, edge cases */

fn test_P1_operator_precedence() -> bool {
    let ctx = ParserContext::new();

    /* Test: a + b * c should have * with higher precedence */
    let result = ctx.get_precedence("*") > ctx.get_precedence("+");
    assert(result, "Operator precedence incorrect");
    true
}

fn test_P2_ternary_associativity() -> bool {
    let expr = "a ? b ? c : d : e";
    let result = fix_ternary_ambiguity(expr);

    /* Verify ternary operators are properly tracked */
    assert(result != "", "Ternary fix failed");
    true
}

fn test_P3_function_call_chains() -> bool {
    let expr = "foo(a)(b)";
    let result = fix_function_call_chains(expr);

    /* Verify function call chains are parsed correctly */
    assert(result != "", "Function call chain fix failed");
    true
}

fn test_P4_empty_function_body() -> bool {
    let body = "{}";
    let result = fix_empty_function_body(body);

    /* Verify empty functions parse correctly */
    assert(result == "{ }", "Empty body fix failed");
    true
}

fn test_P5_nested_ternary() -> bool {
    let expr = "a ? b ? c : d : e ? f : g";
    let result = fix_nested_ternary(expr);

    /* Verify nested ternary operators are handled */
    assert(result != "", "Nested ternary fix failed");
    true
}

