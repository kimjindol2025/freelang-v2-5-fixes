/* Test runner */
pub fn run_all_tests() -> bool {
    let total_tests = 35;
    let passed_tests = 0;

    /* Rule 1 tests */
    if test_P1_operator_precedence() { passed_tests = passed_tests + 1; }
    if test_P2_ternary_associativity() { passed_tests = passed_tests + 1; }
    if test_P3_function_call_chains() { passed_tests = passed_tests + 1; }
    if test_P4_empty_function_body() { passed_tests = passed_tests + 1; }
    if test_P5_nested_ternary() { passed_tests = passed_tests + 1; }

    /* Rule 2 tests */
    if test_R1_basic_variable_declaration() { passed_tests = passed_tests + 1; }
    if test_R2_function_definition() { passed_tests = passed_tests + 1; }
    if test_R3_control_flow() { passed_tests = passed_tests + 1; }
    if test_R4_array_operations() { passed_tests = passed_tests + 1; }
    if test_R5_object_access() { passed_tests = passed_tests + 1; }

    /* Rule 3 tests */
    if test_O1_instruction_cache_hit_ratio() { passed_tests = passed_tests + 1; }
    if test_O2_jump_optimization() { passed_tests = passed_tests + 1; }
    if test_O3_stack_efficiency() { passed_tests = passed_tests + 1; }
    if test_O4_instruction_stream_optimization() { passed_tests = passed_tests + 1; }
    if test_O5_stack_frame_optimization() { passed_tests = passed_tests + 1; }

    /* Rule 4 tests */
    if test_M1_cache_memory_bound() { passed_tests = passed_tests + 1; }
    if test_M2_stack_memory_bound() { passed_tests = passed_tests + 1; }
    if test_M3_instruction_cache_cleanup() { passed_tests = passed_tests + 1; }
    if test_M4_frame_cleanup() { passed_tests = passed_tests + 1; }
    if test_M5_garbage_collection_simulation() { passed_tests = passed_tests + 1; }

    /* Rule 5 tests */
    if test_E1_error_message_format() { passed_tests = passed_tests + 1; }
    if test_E2_stack_trace_formatting() { passed_tests = passed_tests + 1; }
    if test_E3_error_context_extraction() { passed_tests = passed_tests + 1; }
    if test_E4_error_recovery_strategy() { passed_tests = passed_tests + 1; }
    if test_E5_error_clarity_scoring() { passed_tests = passed_tests + 1; }

    /* Rule 6 tests */
    if test_T1_literal_type_inference() { passed_tests = passed_tests + 1; }
    if test_T2_operator_type_promotion() { passed_tests = passed_tests + 1; }
    if test_T3_generic_specialization() { passed_tests = passed_tests + 1; }
    if test_T4_recursive_generic_check() { passed_tests = passed_tests + 1; }
    if test_T5_type_unification() { passed_tests = passed_tests + 1; }

    /* Rule 7 tests */
    if test_ED1_empty_input_handling() { passed_tests = passed_tests + 1; }
    if test_ED2_deeply_nested_expressions() { passed_tests = passed_tests + 1; }
    if test_ED3_unicode_string_handling() { passed_tests = passed_tests + 1; }
    if test_ED4_large_array_operations() { passed_tests = passed_tests + 1; }
    if test_ED5_error_in_error_handling() { passed_tests = passed_tests + 1; }

    /* Rule 8 tests */
    if test_B1_v2_4_0_syntax_support() { passed_tests = passed_tests + 1; }
    if test_B2_v2_4_0_stdlib_compatibility() { passed_tests = passed_tests + 1; }
    if test_B3_v2_4_0_type_system_compatibility() { passed_tests = passed_tests + 1; }
    if test_B4_v2_4_0_error_handling_compatibility() { passed_tests = passed_tests + 1; }
    if test_B5_v2_4_0_performance_baseline() { passed_tests = passed_tests + 1; }

    /* Rule 9 tests */
    if test_D1_all_modules_loadable() { passed_tests = passed_tests + 1; }
    if test_D2_no_critical_bugs() { passed_tests = passed_tests + 1; }
    if test_D3_documentation_complete() { passed_tests = passed_tests + 1; }
    if test_D4_test_coverage_sufficient() { passed_tests = passed_tests + 1; }
    if test_D5_performance_targets_met() { passed_tests = passed_tests + 1; }

    passed_tests == total_tests
}

