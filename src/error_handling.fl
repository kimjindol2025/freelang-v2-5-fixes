/* FreeLang v2.5 Fixes - Error Handling Module */
/* Improvements for error messages, stack traces, and recovery strategies */

pub struct ErrorContext {
    messages: any,
    stack_trace: any,
    recovery_enabled: bool,
    error_count: i32,
}

impl ErrorContext {
    pub fn new() -> Self {
        ErrorContext {
            messages: [],
            stack_trace: [],
            recovery_enabled: true,
            error_count: 0,
        }
    }

    pub fn add_error(&mut self, error: any) {
        push(self.messages, error);
        self.error_count = self.error_count + 1;
    }

    pub fn push_stack_frame(&mut self, frame: string) {
        push(self.stack_trace, frame);
    }

    pub fn pop_stack_frame(&mut self) {
        if length(self.stack_trace) > 0 {
            let n = length(self.stack_trace);
            /* Remove last element */
            let trimmed = [];
            let i = 0;
            while i < n - 1 {
                push(trimmed, self.stack_trace[i]);
                i = i + 1;
            }
            self.stack_trace = trimmed;
        }
    }

    pub fn get_error_count(&self) -> i32 {
        self.error_count
    }

    pub fn set_recovery_enabled(&mut self, enabled: bool) {
        self.recovery_enabled = enabled;
    }
}

pub struct ErrorMessage {
    error_type: string,
    message: string,
    line: i32,
    column: i32,
    context: string,
    severity: string,
}

impl ErrorMessage {
    pub fn new(
        error_type: string,
        message: string,
        line: i32,
        column: i32,
        context: string,
        severity: string,
    ) -> Self {
        ErrorMessage {
            error_type: error_type,
            message: message,
            line: line,
            column: column,
            context: context,
            severity: severity,
        }
    }

    pub fn format(&self) -> string {
        let result = "";
        result = result + self.severity + ": " + self.error_type;
        result = result + " at line " + (self.line as string) + ", col " + (self.column as string);
        result = result + "\n  " + self.message;
        if self.context != "" {
            result = result + "\n  Context: " + self.context;
        }
        result
    }

    pub fn get_severity_level(&self) -> i32 {
        match self.severity {
            "ERROR" => 3,
            "WARNING" => 2,
            "INFO" => 1,
            _ => 0,
        }
    }
}

pub struct StackTrace {
    frames: any,
    max_depth: i32,
}

impl StackTrace {
    pub fn new(max_depth: i32) -> Self {
        StackTrace {
            frames: [],
            max_depth: max_depth,
        }
    }

    pub fn push_frame(&mut self, function: string, line: i32) -> bool {
        if length(self.frames) >= self.max_depth {
            return false;
        }

        let frame = {
            "function": function,
            "line": line,
        };
        push(self.frames, frame);
        true
    }

    pub fn pop_frame(&mut self) {
        if length(self.frames) > 0 {
            let n = length(self.frames);
            let trimmed = [];
            let i = 0;
            while i < n - 1 {
                push(trimmed, self.frames[i]);
                i = i + 1;
            }
            self.frames = trimmed;
        }
    }

    pub fn format(&self) -> string {
        let result = "Stack trace:\n";
        let i = 0;

        while i < length(self.frames) {
            let frame = self.frames[i];
            result = result + "  at " + frame.function + " (line " + (frame.line as string) + ")\n";
            i = i + 1;
        }

        result
    }

    pub fn get_depth(&self) -> i32 {
        length(self.frames)
    }
}

pub struct ErrorRecoveryStrategy {
    strategies: any,
    current_strategy: string,
}

impl ErrorRecoveryStrategy {
    pub fn new() -> Self {
        ErrorRecoveryStrategy {
            strategies: init_recovery_strategies(),
            current_strategy: "default",
        }
    }

    pub fn apply_strategy(&self, error: any) -> any {
        let strategy = self.strategies[error.error_type];
        if strategy != null {
            return strategy;
        }
        self.strategies["default"]
    }

    pub fn set_strategy(&mut self, error_type: string, strategy: any) {
        self.strategies[error_type] = strategy;
    }

    pub fn can_recover(&self, error_type: string) -> bool {
        error_type == "SyntaxError" || error_type == "TypeError"
    }
}

fn init_recovery_strategies() -> any {
    let strategies = {};

    /* Syntax error recovery: skip to next statement */
    strategies["SyntaxError"] = {
        "action": "skip_to_next_statement",
        "continue_parsing": true,
    };

    /* Type error recovery: implicit cast */
    strategies["TypeError"] = {
        "action": "implicit_cast",
        "continue_execution": true,
    };

    /* Division by zero recovery: return default value */
    strategies["DivisionByZero"] = {
        "action": "return_default",
        "default_value": 0,
    };

    /* Null pointer recovery: skip operation */
    strategies["NullPointerException"] = {
        "action": "skip_operation",
        "continue_execution": true,
    };

    strategies
}

/* Fix: Better error messages with context */
pub fn create_detailed_error_message(error_type: string, position: i32, source: string) -> string {
    let line = calculate_line_number(source, position);
    let column = calculate_column_number(source, position);
    let context = extract_context(source, line);

    let message = "";
    message = message + error_type + " at line " + (line as string);
    message = message + ", column " + (column as string);
    message = message + "\n";
    message = message + "  " + context;

    message
}

fn calculate_line_number(source: string, position: i32) -> i32 {
    let line = 1;
    let i = 0;

    while i < position && i < length(source) {
        if source[i] == "\n" {
            line = line + 1;
        }
        i = i + 1;
    }

    line
}

fn calculate_column_number(source: string, position: i32) -> i32 {
    let column = 1;
    let i = position - 1;

    while i >= 0 && source[i] != "\n" {
        column = column + 1;
        i = i - 1;
    }

    column
}

fn extract_context(source: string, line: i32) -> string {
    let current_line = 1;
    let start = 0;
    let i = 0;

    while i < length(source) && current_line < line {
        if source[i] == "\n" {
            current_line = current_line + 1;
            start = i + 1;
        }
        i = i + 1;
    }

    let end = start;
    while end < length(source) && source[end] != "\n" {
        end = end + 1;
    }

    source[start..end]
}

/* Fix: Stack trace collection */
pub fn collect_stack_trace(call_stack: any) -> string {
    let trace = "Stack trace:\n";
    let i = 0;

    while i < length(call_stack) {
        let frame = call_stack[i];
        trace = trace + "  at " + frame.function + " (line " + (frame.line as string) + ")\n";
        i = i + 1;
    }

    trace
}

/* Fix: Error message clarity scoring */
pub fn score_error_clarity(message: string) -> f64 {
    let score = 0.0;

    /* Check for error type */
    if contains(message, "Error") || contains(message, "Exception") {
        score = score + 2.0;
    }

    /* Check for line number */
    if contains(message, "line") {
        score = score + 2.0;
    }

    /* Check for context */
    if contains(message, "Context") || contains(message, "at ") {
        score = score + 2.0;
    }

    /* Check for suggestion */
    if contains(message, "suggestion") || contains(message, "expected") {
        score = score + 3.0;
    }

    /* Normalize to 0-10 scale */
    if score > 10.0 {
        score = 10.0;
    }

    score
}

