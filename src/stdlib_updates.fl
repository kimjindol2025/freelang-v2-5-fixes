/* FreeLang v2.5 Fixes - Standard Library Updates Module */
/* Bug fixes, performance improvements, and new utilities */

pub struct StringUtils {
    cache: any,
    optimization_enabled: bool,
}

impl StringUtils {
    pub fn new() -> Self {
        StringUtils {
            cache: {},
            optimization_enabled: true,
        }
    }

    pub fn to_upper(&self, s: string) -> string {
        if s in self.cache {
            return self.cache[s];
        }

        let result = "";
        let i = 0;

        while i < length(s) {
            let ch = s[i];

            if ch >= "a" && ch <= "z" {
                result = result + ((ch as i32) - 32 as string);
            } else {
                result = result + ch;
            }

            i = i + 1;
        }

        result
    }

    pub fn to_lower(&self, s: string) -> string {
        let result = "";
        let i = 0;

        while i < length(s) {
            let ch = s[i];

            if ch >= "A" && ch <= "Z" {
                result = result + ((ch as i32) + 32 as string);
            } else {
                result = result + ch;
            }

            i = i + 1;
        }

        result
    }

    pub fn trim(&self, s: string) -> string {
        let mut start = 0;
        let mut end = length(s);

        while start < end && (s[start] == " " || s[start] == "\t" || s[start] == "\n") {
            start = start + 1;
        }

        while end > start && (s[end - 1] == " " || s[end - 1] == "\t" || s[end - 1] == "\n") {
            end = end - 1;
        }

        if start >= end { "" } else { s[start..end] }
    }

    pub fn split(&self, s: string, delimiter: string) -> any {
        let parts = [];
        let current = "";
        let i = 0;

        while i < length(s) {
            if s[i] == delimiter {
                push(parts, current);
                current = "";
            } else {
                current = current + s[i];
            }

            i = i + 1;
        }

        push(parts, current);
        parts
    }

    pub fn join(&self, arr: any, delimiter: string) -> string {
        let result = "";
        let i = 0;

        while i < length(arr) {
            result = result + arr[i];

            if i < length(arr) - 1 {
                result = result + delimiter;
            }

            i = i + 1;
        }

        result
    }

    pub fn contains(&self, s: string, substr: string) -> bool {
        let i = 0;

        while i <= length(s) - length(substr) {
            let match = true;
            let j = 0;

            while j < length(substr) {
                if s[i + j] != substr[j] {
                    match = false;
                    break;
                }
                j = j + 1;
            }

            if match {
                return true;
            }

            i = i + 1;
        }

        false
    }

    pub fn replace(&self, s: string, from: string, to: string) -> string {
        let result = "";
        let i = 0;

        while i < length(s) {
            if i + length(from) <= length(s) {
                let substring = s[i..i + length(from)];
                if substring == from {
                    result = result + to;
                    i = i + length(from);
                    continue;
                }
            }

            result = result + s[i];
            i = i + 1;
        }

        result
    }
}

pub struct MathUtils {
    precision: i32,
}

impl MathUtils {
    pub fn new(precision: i32) -> Self {
        MathUtils {
            precision: precision,
        }
    }

    pub fn abs(&self, n: i32) -> i32 {
        if n < 0 { -n } else { n }
    }

    pub fn min(&self, a: i32, b: i32) -> i32 {
        if a < b { a } else { b }
    }

    pub fn max(&self, a: i32, b: i32) -> i32 {
        if a > b { a } else { b }
    }

    pub fn clamp(&self, value: i32, min: i32, max: i32) -> i32 {
        if value < min {
            min
        } else if value > max {
            max
        } else {
            value
        }
    }

    pub fn gcd(&self, a: i32, b: i32) -> i32 {
        let mut x = a;
        let mut y = b;

        while y != 0 {
            let temp = y;
            y = x % y;
            x = temp;
        }

        x
    }

    pub fn lcm(&self, a: i32, b: i32) -> i32 {
        (a * b) / self.gcd(a, b)
    }

    pub fn is_prime(&self, n: i32) -> bool {
        if n < 2 {
            return false;
        }

        if n == 2 {
            return true;
        }

        if n % 2 == 0 {
            return false;
        }

        let i = 3;
        while i * i <= n {
            if n % i == 0 {
                return false;
            }
            i = i + 2;
        }

        true
    }

    pub fn factorial(&self, n: i32) -> i32 {
        if n <= 1 {
            1
        } else {
            n * self.factorial(n - 1)
        }
    }
}

pub struct ArrayUtils {
    sort_comparator: any,
}

impl ArrayUtils {
    pub fn new() -> Self {
        ArrayUtils {
            sort_comparator: null,
        }
    }

    pub fn reverse(&self, arr: any) -> any {
        let reversed = [];
        let i = length(arr) - 1;

        while i >= 0 {
            push(reversed, arr[i]);
            i = i - 1;
        }

        reversed
    }

    pub fn contains(&self, arr: any, value: any) -> bool {
        let i = 0;

        while i < length(arr) {
            if arr[i] == value {
                return true;
            }
            i = i + 1;
        }

        false
    }

    pub fn index_of(&self, arr: any, value: any) -> i32 {
        let i = 0;

        while i < length(arr) {
            if arr[i] == value {
                return i;
            }
            i = i + 1;
        }

        -1
    }

    pub fn slice(&self, arr: any, start: i32, end: i32) -> any {
        let sliced = [];
        let i = start;

        while i < end && i < length(arr) {
            push(sliced, arr[i]);
            i = i + 1;
        }

        sliced
    }

    pub fn concat(&self, arr1: any, arr2: any) -> any {
        let result = [];
        let i = 0;

        while i < length(arr1) {
            push(result, arr1[i]);
            i = i + 1;
        }

        i = 0;
        while i < length(arr2) {
            push(result, arr2[i]);
            i = i + 1;
        }

        result
    }

    pub fn unique(&self, arr: any) -> any {
        let unique = [];
        let i = 0;

        while i < length(arr) {
            if !self.contains(unique, arr[i]) {
                push(unique, arr[i]);
            }
            i = i + 1;
        }

        unique
    }

    pub fn map(&self, arr: any, transformer: any) -> any {
        let mapped = [];
        let i = 0;

        while i < length(arr) {
            push(mapped, transformer(arr[i]));
            i = i + 1;
        }

        mapped
    }

    pub fn filter(&self, arr: any, predicate: any) -> any {
        let filtered = [];
        let i = 0;

        while i < length(arr) {
            if predicate(arr[i]) {
                push(filtered, arr[i]);
            }
            i = i + 1;
        }

        filtered
    }

    pub fn reduce(&self, arr: any, accumulator: any, initial: any) -> any {
        let result = initial;
        let i = 0;

        while i < length(arr) {
            result = accumulator(result, arr[i]);
            i = i + 1;
        }

        result
    }
}

pub struct CollectionUtils {
    capacity: i32,
}

impl CollectionUtils {
    pub fn new(capacity: i32) -> Self {
        CollectionUtils {
            capacity: capacity,
        }
    }

    pub fn create_set() -> any {
        {} /* Use object as set */
    }

    pub fn create_map() -> any {
        {} /* Use object as map */
    }

    pub fn add_to_set(&self, set: any, value: any) -> bool {
        if value in set {
            return false;
        }
        set[value] = true;
        true
    }

    pub fn remove_from_set(&self, set: any, value: any) -> bool {
        if value in set {
            delete set[value];
            return true;
        }
        false
    }

    pub fn set_contains(&self, set: any, value: any) -> bool {
        value in set
    }

    pub fn put_in_map(&self, map: any, key: any, value: any) {
        map[key] = value;
    }

    pub fn get_from_map(&self, map: any, key: any) -> any {
        map[key]
    }

    pub fn remove_from_map(&self, map: any, key: any) -> bool {
        if key in map {
            delete map[key];
            return true;
        }
        false
    }
}

/* Performance improvement helper */
pub fn optimize_function_calls(calls: any) -> i32 {
    let optimized = 0;
    let i = 0;

    while i < length(calls) {
        let call = calls[i];

        /* Check if call can be optimized */
        if call.can_inline {
            optimized = optimized + 1;
        }

        i = i + 1;
    }

    optimized
}

/* Bug fix: Memory leak prevention */
pub fn cleanup_resources(resources: any) -> bool {
    let i = 0;

    while i < length(resources) {
        let resource = resources[i];
        if resource.cleanup != null {
            resource.cleanup();
        }
        i = i + 1;
    }

    true
}

